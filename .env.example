# Copy to .env and fill in to enable real billing. The app runs fine without these
# (demo mode: Pro upgrade is disabled, everything else works).

PORT=3000
# Public base URL used in QR codes + Stripe redirects (set this in production!)
# PUBLIC_URL=https://qr.yourdomain.com
# DB_PATH=./data/dynaqr.db

# --- Stripe (optional) ---
# 1. Create a product + recurring Price in the Stripe dashboard.
# 2. Put the secret key and the Price ID here.
# 3. Add a webhook endpoint pointing to /webhook/stripe and paste its signing secret.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_...                   # Pro, monthly ($9/mo)
# STRIPE_PRICE_ID_ANNUAL=price_...            # Pro, annual ($90/yr) — optional
# STRIPE_PRICE_ID_BUSINESS=price_...          # Business, monthly ($29/mo, branded colors) — optional
# STRIPE_PRICE_ID_BUSINESS_ANNUAL=price_...   # Business, annual ($290/yr) — optional
# STRIPE_WEBHOOK_SECRET=whsec_...
